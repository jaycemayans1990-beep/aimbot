    highlight.Enabled = false
    highlight.Parent = character

    local nameTag = Instance.new("BillboardGui")
    nameTag.Name = "ESP_NameTag"
    nameTag.Adornee = head
    nameTag.Size = UDim2.new(0, 150, 0, 30)
    nameTag.StudsOffset = Vector3.new(0, 2, 0)
    nameTag.AlwaysOnTop = true
    nameTag.Enabled = false

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = player.Name
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = nameTag

    nameTag.Parent = character

    espCache[player] = {
        Highlight = highlight,
        NameTag = nameTag,
        Character = character
    }
end

local function removeESP(player)
    if espCache[player] then
        if espCache[player].Highlight then espCache[player].Highlight:Destroy() end
        if espCache[player].NameTag then espCache[player].NameTag:Destroy() end
        espCache[player] = nil
    end
end

local function processESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local character = player.Character
            
            if character and character:FindFirstChild("HumanoidRootPart") then
                if not espCache[player] or espCache[player].Character ~= character then
                    removeESP(player)
                    createESP(player, character)
                end

                local cache = espCache[player]
                if cache then
                    local isEnemy = isValidEnemy(player)
                    cache.Highlight.Enabled = State.ESP and isEnemy
                    cache.NameTag.Enabled = State.ESPName and isEnemy
                end
            else
                removeESP(player)
            end
        end
    end
end

Players.PlayerRemoving:Connect(removeESP)

task.spawn(function()
    while true do
        processESP()
        task.wait(0.1)
    end
end)

-- 12. Main Camera Engine (Delta-Optimized: RenderStepped + Safe Matrix)
local smoothDir = Vector3.new(0, 0, 0)
local cameraConnection = nil

if cameraConnection then cameraConnection:Disconnect() end

cameraConnection = RunService.RenderStepped:Connect(function(deltaTime)
    local cam = getCamera()
    if not cam then return end

    -- อัปเดต FOV UI (รองรับทั้ง ScreenGui Frame และ Drawing Circle)
    if FOVFrame then
        FOVFrame.Position = UDim2.new(0, cam.ViewportSize.X / 2, 0, cam.ViewportSize.Y / 2)
        FOVFrame.Size = UDim2.new(0, State.FOV * 2, 0, State.FOV * 2)
        FOVFrame.Visible = State.ShowFOV
    elseif FOVCircle then
        pcall(function()
            FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            FOVCircle.Radius = State.FOV
            FOVCircle.Visible = State.ShowFOV
        end)
    end
      
    if not State.Aimbot then 
        currentTarget = nil
        smoothDir = Vector3.new(0, 0, 0)
        return 
    end
    
    currentTarget = getClosestTarget()  
    if currentTarget then  
        local rawTargetPos = getPredictedPosition(currentTarget)  
        if rawTargetPos then  
            local camPos = cam.CFrame.Position
            local rawDir = (rawTargetPos - camPos)
            
            if rawDir.Magnitude > 0.1 then
                local rawForward = rawDir.Unit
                
                -- Smooth direction interpolation
                if smoothDir.Magnitude < 0.001 then
                    smoothDir = rawForward
                else
                    local speed = math.max(0.01, math.min(0.98, State.Smoothness))
                    local lerpFactor = 1 - math.exp(-deltaTime * (speed * 25))
                    smoothDir = smoothDir + (rawForward - smoothDir) * lerpFactor
                end
                
                -- คำนวณ RightVector แบบปลอดภัย (ไม่ใช้ Vector3.xAxis/zAxis)
                local right = cam.CFrame.RightVector
                right = right - smoothDir * right:Dot(smoothDir)
                local rightMag = right.Magnitude
                
                if rightMag < 0.001 then
                    right = Vector3.new(1, 0, 0):Cross(smoothDir)
                    if right.Magnitude < 0.001 then
                        right = Vector3.new(0, 0, 1):Cross(smoothDir)
                    end
                    right = right.Unit
                else
                    right = right / rightMag
                end
                
                local up = right:Cross(smoothDir).Unit
                local targetCFrame = CFrame.fromMatrix(camPos, right, up, -smoothDir)
                
                -- ใช้ Matrix CFrame โดยตรงเพื่อป้องกันอาการกล้องสั่น
                cam.CFrame = targetCFrame
            end
        end  
    else
        if smoothDir.Magnitude > 0.001 then
            local lookVec = cam.CFrame.LookVector
            local lerpFactor = 1 - math.exp(-deltaTime * 10)
            smoothDir = smoothDir + (lookVec - smoothDir) * lerpFactor
        end
    end
end)



