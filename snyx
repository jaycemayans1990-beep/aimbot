-- 7. Target Validation Check
local function isValidEnemy(player)
    if not player or not localPlayer or player == localPlayer or not player.Character then 
        return false 
    end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")  
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")  
      
    if not humanoid or not rootPart or humanoid.Health <= 0 then   
        return false   
    end  
    
    if player.Character:FindFirstChildOfClass("ForceField") then  
        return false  
    end  
    
    if State.TeamCheck then  
        local myTeam = localPlayer.Team
        local targetTeam = player.Team
        if myTeam ~= nil and targetTeam ~= nil and myTeam == targetTeam then  
            return false  
        end  
    end  
    
    return true
end

-- 8. Wall Check Function
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

local function isVisible(targetPart)
    if not State.WallCheck then return true end
    if not targetPart or not targetPart.Parent then return false end

    local character = localPlayer and localPlayer.Character
    if not character then return false end

    local cam = getCamera()
    if not cam then return false end

    raycastParams.FilterDescendantsInstances = {character, cam}

    local origin = cam.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin

    local result = workspace:Raycast(origin, direction, raycastParams)

    if result then
        local targetModel = targetPart:FindFirstAncestorOfClass("Model")
        if targetModel and result.Instance:IsDescendantOf(targetModel) then
            return true
        end
        return false
    end

    return true
end

-- 9. Target Acquisition
local function getClosestTarget()
    local closestPlayer = nil
    local shortestDist = State.FOV
    local cam = getCamera()
    if not cam then return nil end
    
    local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do  
        if isValidEnemy(player) then  
            local char = player.Character
            local targetPart = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))  
            if targetPart then  
                local screenPoint, onScreen = cam:WorldToViewportPoint(targetPart.Position)  
                  
                if onScreen then  
                    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    local effectiveDist = (player == currentTarget) and (dist * 0.85) or dist
                    
                    if effectiveDist < shortestDist then  
                        if isVisible(targetPart) then
                            shortestDist = effectiveDist  
                            closestPlayer = player  
                        end
                    end  
                end  
            end  
        end  
    end  
    return closestPlayer
end

-- 10. Prediction Engine
local function getPredictedPosition(target, bulletSpeed, bulletGravity)
    if not target then return nil end
    local char = target.Character
    if not char then return nil end
    
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local headPart = char:FindFirstChild("Head") or rootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not headPart then return nil end
    
    local cam = getCamera()
    if not cam then return headPart.Position end
    
    local targetPos = headPart.Position
    if not State.Prediction then return targetPos end
    
    local camPos = cam.CFrame.Position
    local v = math.max(bulletSpeed or cachedBulletSpeed or 1000, 1)
    local g = bulletGravity or cachedBulletGravity or 0
    local pingSec = ((getPing() or 0) / 2000.0)
    
    local rawVel = rootPart.AssemblyLinearVelocity or Vector3.zero
    local isSeated = humanoid and (humanoid.Sit or humanoid.SeatPart ~= nil)
    
    local targetVelY = isSeated and rawVel.Y or math.clamp(rawVel.Y, -200, 200)
    local targetVel = Vector3.new(rawVel.X, targetVelY, rawVel.Z)
    
    local targetAccel = Vector3.zero
    if humanoid and not isSeated then
        local state = humanoid:GetState()
        local isAir = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping)
        if isAir then
            targetAccel = Vector3.new(0, -workspace.Gravity, 0)
        end
    end
    
    local t = (targetPos - camPos).Magnitude / v + pingSec
    local predictedPos = targetPos
    
    for iter = 1, 8 do
        local newPos = targetPos + (targetVel * t) + (0.5 * targetAccel * (t * t))
        local newDist = (newPos - camPos).Magnitude
        local newT = (newDist / v) + pingSec
        
        if math.abs(newT - t) < 0.001 then
            t = newT
            predictedPos = newPos
            break
        end
        t = newT
        predictedPos = newPos
    end
    
    local bulletDrop = 0.5 * g * (t * t)
    return predictedPos + Vector3.new(0, bulletDrop, 0)
end

-- 11. ESP Management (GPU Optimized Engine v2.0 - 60Hz Heartbeat)
local MAX_ESP_DISTANCE = 1500
local UPDATE_RATE = 60
local lastUpdateTime = 0

local function createESP(player, character)
    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 2)
    if not head then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = Color3.fromRGB(180, 0, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
    highlight.FillTransparency = 0.15
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = character

    local nameTag = Instance.new("BillboardGui")
    nameTag.Name = "ESP_NameTag"
    nameTag.Adornee = head
    nameTag.Size = UDim2.new(0, 150, 0, 30)
    nameTag.StudsOffset = Vector3.new(0, 2, 0)
    nameTag.AlwaysOnTop = true
    nameTag.MaxDistance = MAX_ESP_DISTANCE
    nameTag.Enabled = false

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = player.Name
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = nameTag

    nameTag.Parent = character

    espCache[player] = {
        Highlight = highlight,
        NameTag = nameTag,
        Character = character
    }
end

local function removeESP(player)
    if espCache[player] then
        if espCache[player].Highlight then espCache[player].Highlight:Destroy() end
        if espCache[player].NameTag then espCache[player].NameTag:Destroy() end
        espCache[player] = nil
    end
end

local function processESP()
    local cam = getCamera()
    if not cam then return end

    local camPos = cam.CFrame.Position
    local stateESP = State and State.ESP
    local stateESPName = State and State.ESPName

    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end

        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if character and rootPart then
            if not espCache[player] or espCache[player].Character ~= character then
                removeESP(player)
                createESP(player, character)
            end

            local cache = espCache[player]
            if cache then
                local isEnemy = isValidEnemy(player)
                
                if isEnemy and (stateESP or stateESPName) then
                    local dist = (rootPart.Position - camPos).Magnitude
                    if dist <= MAX_ESP_DISTANCE then
                        local _, onScreen = cam:WorldToViewportPoint(rootPart.Position)
                        cache.Highlight.Enabled = stateESP and onScreen
                        cache.NameTag.Enabled = stateESPName and onScreen
                    else
                        cache.Highlight.Enabled = false
                        cache.NameTag.Enabled = false
                    end
                else
                    cache.Highlight.Enabled = false
                    cache.NameTag.Enabled = false
                end
            end
        else
            removeESP(player)
        end
    end
end

Players.PlayerRemoving:Connect(removeESP)

RunService.Heartbeat:Connect(function()
    local currentTime = os.clock()
    if currentTime - lastUpdateTime >= (1 / UPDATE_RATE) then
        processESP()
        lastUpdateTime = currentTime
    end
end)

-- 12. Main Camera Engine
RunService:UnbindFromRenderStep("AimbotCameraUpdate")
RunService:BindToRenderStep("AimbotCameraUpdate", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    local cam = getCamera()
    if not cam then return end

    FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)  
    FOVCircle.Radius = State.FOV  
    FOVCircle.Visible = State.ShowFOV  
      
    if not State.Aimbot then 
        currentTarget = nil
        return 
    end
    
    currentTarget = getClosestTarget()  
    if currentTarget then  
        local targetPos = getPredictedPosition(currentTarget)  
        if targetPos then  
            local camPos = cam.CFrame.Position
            local dir = (targetPos - camPos)
            
            if dir.Magnitude > 0.1 then
                local forward = dir.Unit
                local right = cam.CFrame.RightVector

                right = right - forward * right:Dot(forward)
                local rightMag = right.Magnitude

                if rightMag < 0.001 then
                    right = Vector3.xAxis:Cross(forward)
                    if right.Magnitude < 0.001 then
                        right = Vector3.zAxis:Cross(forward)
                    end
                    right = right.Unit
                else
                    right = right / rightMag
                end

                local up = right:Cross(forward).Unit
                local targetCFrame = CFrame.fromMatrix(camPos, right, up, -forward)
                
                if State.Smoothness >= 0.99 then
                    cam.CFrame = targetCFrame
                else
                    local speed = math.clamp(State.Smoothness, 0.01, 0.98)
                    local alpha = 1 - ((1 - speed) ^ (deltaTime * 60))
                    cam.CFrame = cam.CFrame:Lerp(targetCFrame, alpha)
                end
            end
        end  
    end
end)

