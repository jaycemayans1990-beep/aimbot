-- 6. Target Validation Check
local function isValidEnemy(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")  
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")  
      
    if not humanoid or not rootPart or humanoid.Health <= 0 then   
        return false   
    end  
    
    if player.Character:FindFirstChildOfClass("ForceField") then  
        return false  
    end  
    
    if State.TeamCheck then  
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then  
            return false  
        end  
    end  
    
    return true
end

-- 7. Fixed & Memory-Optimized Wall Check
local function isVisible(targetPart)
    if not State.WallCheck then return true end
    
    local camera = getCamera()  
    if not camera then return false end
    
    local origin = camera.CFrame.Position  
    local destination = targetPart.Position  
    local direction = destination - origin  
      
    local filterList = {camera}
    if LocalPlayer.Character then
        table.insert(filterList, LocalPlayer.Character)
    end
    
    if targetPart.Parent then
        table.insert(filterList, targetPart.Parent)
    end

    raycastParams.FilterDescendantsInstances = filterList  
    local result = Workspace:Raycast(origin, direction, raycastParams)  
      
    return result == nil
end

-- 8. Target Acquisition
local function getClosestTarget()
    local closestPlayer = nil
    local shortestDist = State.FOV
    local camera = getCamera()
    if not camera then return nil end
    
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do  
        if isValidEnemy(player) then  
            local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")  
            if targetPart and isVisible(targetPart) then  
                local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)  
                  
                if onScreen then  
                    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    local effectiveDist = (player == currentTarget) and (dist * 0.85) or dist
                    
                    if effectiveDist < shortestDist then  
                        shortestDist = effectiveDist  
                        closestPlayer = player  
                    end  
                end  
            end  
        end  
    end  
    return closestPlayer
end

-- 9. Dynamic Prediction Engine (Optimized Ballistics)
local function getPredictedPosition(target)
    if not target or not target.Character then return nil end
    
    local targetPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")  
    local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart or not rootPart then return nil end  
      
    local targetPos = targetPart.Position  
    
    if State.Prediction then  
        local camera = getCamera()
        if not camera then return targetPos end
        
        local distance = (targetPos - camera.CFrame.Position).Magnitude
        local currentPing = getPing()
        
        local bulletTime = distance / math.max(State.BulletSpeed, 1)
        local totalTime = bulletTime + currentPing
        
        local targetVelocity = rootPart.AssemblyLinearVelocity  
        local predictedOffset = targetVelocity * totalTime
        
        local gravity = Workspace.Gravity
        local dropCompensation = Vector3.new(0, 0.5 * gravity * (totalTime ^ 2), 0)
        
        targetPos = targetPos + predictedOffset + dropCompensation
    end  
      
    return targetPos
end

-- 10. ESP Management System
local function removePlayerESP(character)
    if not character then return end
    local highlight = character:FindFirstChild("ESP_Highlight")
    if highlight then highlight:Destroy() end
    
    local nameTag = character:FindFirstChild("ESP_NameTag")
    if nameTag then nameTag:Destroy() end
end

local function processESP()
    for _, player in ipairs(Players:GetPlayers()) do  
        if player ~= LocalPlayer then
            if player.Character and isValidEnemy(player) then  
                if State.ESP then
                    local highlight = player.Character:FindFirstChild("ESP_Highlight")  
                    if not highlight then  
                        highlight = Instance.new("Highlight")  
                        highlight.Name = "ESP_Highlight"  
                        highlight.FillColor = Color3.fromRGB(180, 0, 255)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                        highlight.FillTransparency = 0.15
                        highlight.OutlineTransparency = 0
                        highlight.Parent = player.Character
                    end  
                else
                    local highlight = player.Character:FindFirstChild("ESP_Highlight")
                    if highlight then highlight:Destroy() end
                end

                if State.ESPName then
                    local head = player.Character:FindFirstChild("Head")
                    if head then
                        local nameTag = player.Character:FindFirstChild("ESP_NameTag")
                        if not nameTag then
                            nameTag = Instance.new("BillboardGui")
                            nameTag.Name = "ESP_NameTag"
                            nameTag.Adornee = head
                            nameTag.Size = UDim2.new(0, 150, 0, 30)
                            nameTag.StudsOffset = Vector3.new(0, 2, 0)
                            nameTag.AlwaysOnTop = true
                            nameTag.Parent = player.Character

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.Text = player.Name
                            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            textLabel.Font = Enum.Font.SourceSansBold
                            textLabel.TextSize = 14
                            textLabel.Parent = nameTag
                        end
                    end
                else
                    local nameTag = player.Character:FindFirstChild("ESP_NameTag")
                    if nameTag then nameTag:Destroy() end
                end
            elseif player.Character then  
                removePlayerESP(player.Character)
            end  
        end
    end
end

task.spawn(function()
    while true do
        processESP()
        task.wait(0.15)
    end
end)

-- 11. Main Camera Engine
RunService:UnbindFromRenderStep("AimbotCameraUpdate")
RunService:BindToRenderStep("AimbotCameraUpdate", Enum.RenderPriority.Camera.Value, function(deltaTime)
    local camera = getCamera()
    if not camera then return end
    
    FOVCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)  
    FOVCircle.Radius = State.FOV  
    FOVCircle.Visible = State.ShowFOV  
      
    if not State.Aimbot then 
        currentTarget = nil
        return 
    end
    
    currentTarget = getClosestTarget()  
    if currentTarget then  
        local targetPos = getPredictedPosition(currentTarget)  
        if targetPos then  
            local targetCFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)  
            local lerpAlpha = math.clamp((1 - State.Smoothness) * (deltaTime * 60), 0.05, 1)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, lerpAlpha)
        end  
    end  
end)

