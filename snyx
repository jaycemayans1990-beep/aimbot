-- 5. ACS & Weapon Speed Auto Detection
local function getEffectiveBulletSpeed()
    if State.AutoBulletSpeed and localPlayer and localPlayer.Character then
        local tool = localPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            -- สแกนหา Module Config ของ ACS Engine / Tool General Settings
            local acsSettings = tool:FindFirstChild("ACS_Settings") or tool:FindFirstChild("Settings") or tool:FindFirstChild("Config")
            if acsSettings and acsSettings:IsA("ModuleScript") then
                local success, config = pcall(require, acsSettings)
                if success and type(config) == "table" then
                    local speed = config.Velo or config.MuzzleVelocity or config.BulletSpeed
                    if type(speed) == "number" and speed > 0 then
                        return speed
                    end
                end
            end
            -- สแกนหา Attribute ของตัว Tool
            for name, value in pairs(tool:GetAttributes()) do
                local lower = name:lower()
                if (lower:find("speed") or lower:find("velocity") or lower:find("velo")) and type(value) == "number" then
                    return value
                end
            end
        end
    end
    return math.max(State.BulletSpeed or 2000, 1)
end

