-- 7. Target Validation Check
local function isValidEnemy(player)
    if not player or not localPlayer or player == localPlayer or not player.Character then 
        return false 
    end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")  
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")  
      
    if not humanoid or not rootPart or humanoid.Health <= 0 then   
        return false   
    end  
    
    if player.Character:FindFirstChildOfClass("ForceField") then  
        return false  
    end  
    
    if State.TeamCheck then  
        local myTeam = localPlayer.Team
        local targetTeam = player.Team
        if myTeam ~= nil and targetTeam ~= nil and myTeam == targetTeam then  
            return false  
        end  
    end  
    
    return true
end

-- 8. Wall Check Function (Optimized)
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

local filterList = {}

local function isVisible(targetPart)
    if not State.WallCheck then return true end
    if not targetPart or not targetPart.Parent then return false end

    local character = localPlayer and localPlayer.Character
    if not character then return false end

    local cam = getCamera()
    if not cam then return false end

    filterList[1] = character
    raycastParams.FilterDescendantsInstances = filterList

    local origin = cam.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin

    local result = workspace:Raycast(origin, direction, raycastParams)

    if result then
        local targetModel = targetPart:FindFirstAncestorOfClass("Model")
        if targetModel and result.Instance:IsDescendantOf(targetModel) then
            return true
        end
        return false
    end

    return true
end

-- 9. Target Acquisition
local function getClosestTarget()
    local closestPlayer = nil
    local shortestDist = State.FOV
    local cam = getCamera()
    local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do  
        if isValidEnemy(player) then  
            local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")  
            if targetPart then  
                local screenPoint, onScreen = cam:WorldToViewportPoint(targetPart.Position)  
                  
                if onScreen then  
                    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    local effectiveDist = (player == currentTarget) and (dist * 0.85) or dist
                    
                    if effectiveDist < shortestDist then  
                        if isVisible(targetPart) then
                            shortestDist = effectiveDist  
                            closestPlayer = player  
                        end
                    end  
                end  
            end  
        end  
    end  
    return closestPlayer
end


-- 10. Pure Physics Dynamic Prediction Engine (Delta-Optimized)
local velocityHistory = setmetatable({}, {__mode = "k"})
local lastTickTime = setmetatable({}, {__mode = "k"})

local function clamp(val, min, max)
    return math.max(min, math.min(max, val))
end

local function getPredictedPosition(target, bulletSpeed, bulletGravity, pingOffsetSec)
    if not target then return nil end
    local char = target.Character
    if not char then return nil end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local headPart = char:FindFirstChild("Head") or rootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not headPart then return nil end

    local cam = workspace.CurrentCamera
    if not cam then return headPart.Position end

    local targetPos = headPart.Position
    if not State.Prediction then return targetPos end

    local camPos = cam.CFrame.Position
    local v = math.max(bulletSpeed or cachedBulletSpeed or 3500, 1)
    local g = bulletGravity or cachedBulletGravity or 0

    local rawPing = getPing() or 0
    local pingInSec = (rawPing > 5) and (rawPing / 1000.0) or rawPing
    local pingSec = pingOffsetSec or (pingInSec + 0.0166)

    -- ใช้ os.clock() เพื่อความแม่นยำสูงใน Android/Delta
    local now = os.clock()
    local lastTime = lastTickTime[target] or (now - 0.016)
    local dt = clamp(now - lastTime, 0.001, 0.1)
    lastTickTime[target] = now

    if not velocityHistory[target] then velocityHistory[target] = {} end
    local hist = velocityHistory[target]

    -- Fallback สำหรับ AssemblyLinearVelocity บน Mobile Physics
    local rawVel = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.new(0, 0, 0)
    local currentVel = Vector3.new(rawVel.X, clamp(rawVel.Y, -80, 80), rawVel.Z)

    table.insert(hist, currentVel)
    if #hist > 5 then table.remove(hist, 1) end

    -- เปลี่ยน Vector3.zero เป็น Vector3.new(0, 0, 0) ป้องกัน Delta Error
    local avgVel = Vector3.new(0, 0, 0)
    for _, vel in ipairs(hist) do
        avgVel = avgVel + vel
    end
    avgVel = avgVel / #hist

    local targetAccel = Vector3.new(0, 0, 0)
    if #hist >= 2 then
        local prevVel = hist[#hist - 1]
        targetAccel = (currentVel - prevVel) / dt
        if targetAccel.Magnitude > 40 then
            targetAccel = targetAccel.Unit * 40
        end
    elseif humanoid then
        local state = humanoid:GetState()
        local isAir = (state == Enum.HumanoidStateType.Freefall or
                       state == Enum.HumanoidStateType.Jumping or
                       humanoid.FloorMaterial == Enum.Material.Air)
        if isAir then
            targetAccel = Vector3.new(0, -g, 0)
        end
    end

    if g < 0.01 then
        local predictedPos = targetPos
        for iter = 1, 4 do
            local dist = (predictedPos - camPos).Magnitude
            local tof = (dist / v) + pingSec
            predictedPos = targetPos + (avgVel * tof) + (0.5 * targetAccel * (tof * tof))
        end
        return predictedPos
    end

    local predictedPos = targetPos
    local lastTanTheta = 0

    for iter = 1, 6 do
        local diff = predictedPos - camPos
        local flatDiff = Vector3.new(diff.X, 0, diff.Z)
        local horizDist = flatDiff.Magnitude
        local vertDist = diff.Y

        if horizDist < 0.001 then
            local tofVert = math.abs(vertDist) / math.max(v, 0.001) + pingSec
            predictedPos = targetPos + avgVel * tofVert + 0.5 * targetAccel * (tofVert * tofVert)
            lastTanTheta = (vertDist >= 0) and 1e6 or -1e6
            break
        end

        local v2 = v * v
        local disc = v2 * v2 - g * (g * horizDist * horizDist + 2 * vertDist * v2)

        if disc < 0 then
            lastTanTheta = (vertDist + 0.5 * g * (horizDist / v)^2) / math.max(horizDist, 0.001)
            break
        end

        local sqrtDisc = math.sqrt(disc)
        local tanTheta = (v2 - sqrtDisc) / (g * horizDist)
        lastTanTheta = tanTheta

        local cosTheta = 1.0 / math.sqrt(1.0 + tanTheta * tanTheta)
        local tof = (horizDist / (v * cosTheta)) + pingSec

        local newPos = targetPos + avgVel * tof + 0.5 * targetAccel * (tof * tof)

        if (newPos - predictedPos).Magnitude < 0.01 then
            predictedPos = newPos
            break
        end

        predictedPos = predictedPos * 0.4 + newPos * 0.6
    end

    local diff = predictedPos - camPos
    local flatDiff = Vector3.new(diff.X, 0, diff.Z)
    local finalHorizDist = flatDiff.Magnitude

    if finalHorizDist < 0.01 then
        return predictedPos
    end

    return camPos + (flatDiff.Unit * finalHorizDist) + Vector3.new(0, finalHorizDist * lastTanTheta, 0)
end


